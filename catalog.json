  {
   "id": "dwno",
   "name": "Digimon World Next Order",
   "appid": "1530160",
   "dest": "",
   "process": "Digimon World Next Order.exe",
   "saves": [
    "%USERPROFILE%\\AppData\\LocalLow\\Bandai Namco Entertainment\\Digimon World Next Order"
   ],
   "bridge": "DWNOGift.exe",
   "version": "1.4.0",
   "changelog": "TikFinity webhook with the gift sender's name in every popup; gift spam is queued, nothing is lost.",
   "port": 21301,
   "after_install": "Start the game once: the first start with BepInEx takes 1-3 minutes (black screen). That is normal.",
   "howto": [
    "Click Start in the launcher (it opens DWNOGift.exe and the game). Keep the black DWNOGift window open while you stream.",
    "Triggers tab: add TikTok gifts, follows, shares, likes or chat commands and pick the effect each one triggers. Then click the TikTok button at the top, type your username and Connect after you go LIVE. The launcher must stay open (it keeps running in the background while you are live).",
    "The first game start with BepInEx takes 1-3 minutes on a black screen. That is normal.",
    "Prefer TikFinity? TikFinity > Actions > Webhook: http://127.0.0.1:21301/<effect>?name={nickname}",
    "Or use TikFinity key presses: hotkeys live in BepInEx\\config\\DWNO_GiftMod.txt in the game folder.",
    "Never put the same gift on a webhook AND a key press, or it fires twice.",
    "Windows Smart App Control or an antivirus may block BepInEx or the .exe files (they are not code-signed). Allow them."
   ],
   "effects": [
    [
     "money:1000",
     "+1000 Bits (money:-500 takes Bits)"
    ],
    [
     "item:Hunk of Meat:2",
     "give an item by name, any amount"
